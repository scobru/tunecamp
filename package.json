{
  "name": "tunecamp",
  "version": "2.17.4",
  "description": "A decentralized music platform for artists and labels, with streaming, federation, and Subsonic API support",
  "main": "dist/server/server.js",
  "type": "module",
  "private": true,
  "workspaces": [
    "webapp"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch & npm run watch:css",
    "start": "node --expose-gc dist/index.js",
    "test": "npx --node-options=--experimental-vm-modules jest",
    "migrate:dedupe": "node dist/tools/migrate-dedupe.js",
    "migrate:visibility": "node dist/tools/migrate-visibility.js",
    "build:css": "tailwindcss -i webapp/css/input.css -o webapp/css/style.css",
    "watch:css": "tailwindcss -i webapp/css/input.css -o webapp/css/style.css --watch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "postinstall": "node scripts/patch-ffmpeg.js && node scripts/patch-slsk.js"
  },
  "keywords": [
    "music",
    "streaming",
    "subsonic",
    "activitypub",
    "federation",
    "audio"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fedify/express": "^1.10.3",
    "@fedify/fedify": "^1.10.3",
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sentry/node": "^10.57.0",
    "adm-zip": "^0.5.16",
    "andrade-soulseek-downloader": "^1.0.28",
    "archiver": "^7.0.1",
    "axios": "^1.15.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "disconnect": "^1.2.2",
    "domhandler": "^5.0.3",
    "ethers": "^6.16.0",
    "express": "^4.21.2",
    "extract-zip": "^2.0.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.5",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "music-metadata": "^11.12.3",
    "node-id3": "^0.2.9",
    "p-limit": "^7.3.0",
    "stripe": "^22.1.1",
    "tar": "^7.5.19",
    "telegraf": "^4.16.3",
    "waveform-data": "^4.5.2",
    "webtorrent": "^2.8.5",
    "ws": "^8.21.0",
    "xmlbuilder2": "^4.0.3",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@tailwindcss/cli": "^4.1.18",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/express": "^4.17.25",
    "@types/extract-zip": "^2.0.0",
    "@types/ffprobe-static": "^2.0.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.37",
    "@types/supertest": "^6.0.3",
    "@types/tar": "^6.1.13",
    "@types/webtorrent": "^0.110.1",
    "@types/ws": "^8.18.1",
    "daisyui": "^5.5.16",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.6",
    "tsx": "^4.22.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.3"
  }
}
