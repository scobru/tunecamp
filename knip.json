{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/index.ts",
        "src/tools/*.ts",
        "src/server/tools/*.ts",
        "src/server/modules/workers/heavy-task.worker.ts"
      ],
      "project": [
        "src/**/*.ts",
        "!src/**/*.test.ts"
      ],
      "ignore": [],
      "ignoreDependencies": [
        "daisyui",
        "tailwindcss",
        "tsx"
      ],
      "ignoreIssues": {
        "src/utils/fileUtils.ts": ["exports"]
      }
    },
    "webapp": {
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "autoprefixer"
      ]
    }
  }
}
