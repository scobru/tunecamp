{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/index.ts",
        "src/tools/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "!src/**/*.test.ts"
      ],
      "ignore": [
        "check_db.js",
        "website/**/*"
      ],
      "ignoreDependencies": [
        "daisyui",
        "tailwindcss",
        "tsx"
      ]
    },
    "webapp": {
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.{ts,tsx}"
      ],
      "ignore": [
        "src/types/color-thief-react.d.ts",
        "src/types/material-web.d.ts",
        "src/zen.d.ts",
        "src/stubs/empty.js"
      ],
      "ignoreDependencies": [
        "autoprefixer",
        "daisyui",
        "tailwindcss"
      ]
    }
  }
}
